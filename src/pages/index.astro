---
import Landing from '../components/landing/Landing.jsx';
import Seo from '../components/seo/Seo.astro';
import { SITE, DECKS, absolute, allSouls, creatorLd } from '../lib/site.js';

const { title, description } = SITE;
const souls = allSouls();
// structured data: the site, and the souls it offers as a list
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url, description, author: creatorLd() },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Souls for AI agents',
    numberOfItems: souls.length,
    itemListElement: souls.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: absolute(s.page) })),
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo title={title} description={description} path="/" markdown="/index.md" jsonLd={jsonLd} image="/og/home.png" imageAlt="Give your AI agents a soul: a fan of giveitasoul personality cards" />
    <meta name="theme-color" content="#F4F0E8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&family=Bodoni+Moda:ital,wght@1,700&family=Bricolage+Grotesque:opsz,wght@12..96,800&family=Caveat:wght@700&family=Young+Serif&family=Space+Mono:wght@700&family=Nunito:wght@800&family=Unbounded:wght@700&family=Anton&family=Quicksand:wght@600&family=DM+Serif+Display&display=swap"
    />
  </head>
  <body>
    <main class="viewport">
      <!-- The landing is designed on a 1440×900 stage (390×844 on phones) and scaled to fit the window. -->
      <div class="stage" id="stage">
        <Landing client:only="react" />
      </div>
      <noscript>
        <div class="fallback">
          <h1>Give your AI agents a soul.</h1>
          <p>{description}</p>
        </div>
      </noscript>
      <!-- The wheel is drawn by script; this is every soul as plain links, for screen readers and search engines. -->
      <nav class="sr-only" aria-label="All souls">
        {DECKS.map((deck) => (
          <section>
            <h2>{deck.label} souls</h2>
            <ul>
              {souls.filter((s) => s.deck === deck.label).map((s) => (
                <li><a href={s.page}>{s.name}</a>: {s.type}. {s.line}</li>
              ))}
            </ul>
          </section>
        ))}
        <p>For AI agents: <a href="/llms.txt">llms.txt</a>, or <a href="/index.md">this page as markdown</a>.</p>
      </nav>
    </main>
    <script is:inline>
      (function () {
        var stage = document.getElementById('stage');
        function fit() {
          // the artboard's size comes from CSS: 1440x900, or 390x844 on phones
          var W = stage.offsetWidth, H = stage.offsetHeight;
          var s = Math.min(window.innerWidth / W, window.innerHeight / H);
          stage.style.setProperty('--s', String(s));
          // how far the window extends past the artboard, in artboard pixels
          stage.style.setProperty('--ext', String(Math.max(0, (window.innerWidth / s - W) / 2)));
          stage.style.setProperty('--exty', String(Math.max(0, (window.innerHeight / s - H) / 2)));
        }
        fit();
        window.addEventListener('resize', fit);
      })();
    </script>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    height: 100%;
    overflow: hidden;
    background: #f4f0e8;
    color: #141210;
    font-family: Geist, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    overscroll-behavior: none;
  }
  a { color: #141210; }
  a:hover { color: #4a443c; }
  .viewport {
    position: fixed;
    inset: 0;
    overflow: hidden;
  }
  .stage {
    --s: 1;
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1440px;
    height: 900px;
    transform: translate(-50%, -50%) scale(var(--s));
    transform-origin: 50% 50%;
  }
  @media (max-width: 700px) {
    .stage { width: 390px; height: 844px; }
  }
  /* no tap highlight box or long-press callout on phones: cards and buttons have their own pressed motion */
  .wheel { touch-action: none; cursor: grab; outline: none; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent; -webkit-touch-callout: none; }
  .wheel:active { cursor: grabbing; }
  .slotbtn { all: unset; display: block; cursor: pointer; border-radius: 20px; }
  .slotbtn:focus-visible { outline: 2px solid #141210; outline-offset: 4px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .fallback { max-width: 560px; margin: 20vh auto 0; padding: 0 24px; text-align: center; }
  .fallback h1 { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; font-size: 56px; line-height: 1; margin: 0 0 16px; }
</style>
